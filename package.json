{
    "name":  "kone-digital",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build": "tsc && vite build",
                    "postbuild": "node -e \"try { require('child_process').execSync('npx react-snap', {stdio: 'inherit'}); } catch (e) { console.log('SPA fallback ready.'); }\"",
                    "lint":  "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
                    "preview":  "vite preview",
                    "predeploy":  "npm run build",
                    "deploy":  "gh-pages -d dist --dotfiles",
                    "postinstall":  "node patch-react-snap.cjs"
                },
    "dependencies":  {
                         "firebase":  "^12.12.1",
                         "react":  "^18.2.0",
                         "react-dom":  "^18.2.0"
                     },
    "devDependencies":  {
                            "@types/react":  "^18.2.66",
                            "@types/react-dom":  "^18.2.22",
                            "@vitejs/plugin-react":  "^4.2.1",
                            "gh-pages":  "^6.3.0",
                            "react-snap":  "^1.23.0",
                            "typescript":  "^5.2.2",
                            "vite":  "^5.2.0"
                        },
    "reactSnap":  {
                      "source":  "dist",
                      "ignoreErrors": true,
                      "userAgent": "ReactSnap",
                      "concurrency": 2,
                      "puppeteer": {
                          "waitUntil": "load"
                      },
                      "include": [
                          "/",
                          "/services",
                          "/services/web-development",
                          "/services/mobile-apps",
                          "/services/brand-design",
                          "/services/cloud-devops",
                          "/work",
                          "/pricing"
                      ],
                      "puppeteerArgs":  [
                                            "--no-sandbox",
                                            "--disable-setuid-sandbox",
                                            "--disable-gpu"
                                        ]
                  },
    "overrides":  {
                      "react-snap":  {
                                         "puppeteer":  "^22.0.0"
                                     }
                  }
}
